{
  "name": "@richardmcquiston01/online-catalog-cms",
  "version": "0.1.3",
  "description": "Headless TypeScript CMS engine for managing an online product catalog",
  "license": "Apache-2.0",
  "author": "Richard McQuiston <richard.mcquiston01@gmail.com>",
  "type": "module",
  "exports": {
    ".": {
      "browser": {
        "types": "./dist/browser.d.ts",
        "default": "./dist/browser.js"
      },
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./browser": {
      "import": {
        "types": "./dist/browser.d.ts",
        "default": "./dist/browser.js"
      },
      "require": {
        "types": "./dist/browser.d.cts",
        "default": "./dist/browser.cjs"
      }
    },
    "./sqlite": {
      "import": {
        "types": "./dist/sqlite.d.ts",
        "default": "./dist/sqlite.js"
      },
      "require": {
        "types": "./dist/sqlite.d.cts",
        "default": "./dist/sqlite.cjs"
      }
    },
    "./postgres": {
      "import": {
        "types": "./dist/postgres.d.ts",
        "default": "./dist/postgres.js"
      },
      "require": {
        "types": "./dist/postgres.d.cts",
        "default": "./dist/postgres.cjs"
      }
    },
    "./mysql": {
      "import": {
        "types": "./dist/mysql.d.ts",
        "default": "./dist/mysql.js"
      },
      "require": {
        "types": "./dist/mysql.d.cts",
        "default": "./dist/mysql.cjs"
      }
    },
    "./redis": {
      "import": {
        "types": "./dist/redis.d.ts",
        "default": "./dist/redis.js"
      },
      "require": {
        "types": "./dist/redis.d.cts",
        "default": "./dist/redis.cjs"
      }
    },
    "./mongodb": {
      "import": {
        "types": "./dist/mongodb.d.ts",
        "default": "./dist/mongodb.js"
      },
      "require": {
        "types": "./dist/mongodb.d.cts",
        "default": "./dist/mongodb.cjs"
      }
    },
    "./storage/local": {
      "import": {
        "types": "./dist/storage-local.d.ts",
        "default": "./dist/storage-local.js"
      },
      "require": {
        "types": "./dist/storage-local.d.cts",
        "default": "./dist/storage-local.cjs"
      }
    },
    "./storage/s3": {
      "import": {
        "types": "./dist/storage-s3.d.ts",
        "default": "./dist/storage-s3.js"
      },
      "require": {
        "types": "./dist/storage-s3.d.cts",
        "default": "./dist/storage-s3.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist"],
  "sideEffects": false,
  "keywords": [
    "cms",
    "catalog",
    "headless",
    "typescript",
    "sqlite",
    "postgres",
    "mysql",
    "mongodb",
    "redis",
    "s3"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/RichardMcQuiston01/online-catalog-cms.git"
  },
  "bugs": {
    "url": "https://github.com/RichardMcQuiston01/online-catalog-cms/issues"
  },
  "homepage": "https://github.com/RichardMcQuiston01/online-catalog-cms#readme",
  "engines": {
    "node": ">=18.0.0",
    "bun": ">=1.0.0"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "smoke:dist": "bun run scripts/smoke-dist.ts",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "prepublishOnly": "bun run typecheck && bun run test && bun run build"
  },
  "optionalDependencies": {
    "@aws-sdk/client-s3": "^3.0.0",
    "better-sqlite3": "^9.0.0",
    "ioredis": "^5.0.0",
    "mongodb": "^6.0.0",
    "mysql2": "^3.0.0",
    "postgres": "^3.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.0",
    "@types/better-sqlite3": "^7.0.0",
    "@types/node": "^22.0.0",
    "bun-types": "^1.3.14",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "vitest": "^2.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "trustedDependencies": ["@biomejs/biome"]
}
